# DevTools Environment Variables
# Copy this file to .env.local and adjust as needed for local development

# SSE Endpoint Override (optional)
# Use this in dev mode to point to a local backend server
# The VITE_ prefix is required - Vite only exposes env vars with this prefix to client code
# If not set, the app will use the current host with path: /devtools/api/events
VITE_SSE_ENDPOINT=http://localhost:8080/devtools/api/events
